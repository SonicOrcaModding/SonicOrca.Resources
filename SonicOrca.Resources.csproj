<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(SonicOrcaTargetFramework)</TargetFramework>
    <RootNamespace>SonicOrca</RootNamespace>
    <AssemblyName>SonicOrca.Resources</AssemblyName>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProjectGuid>{4280AADB-980E-41E1-BD06-F56350E9E93B}</ProjectGuid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\x86\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Platform)' != 'Switch'">
    <ProjectReference Include="..\SonicOrca.Common\SonicOrca.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'Switch'">
    <Reference Include="SonicOrca.Common" HintPath="..\SonicOrca.Common\bin\Switch\$(Configuration)\SonicOrca.Common.dll" />
  </ItemGroup>
</Project>
